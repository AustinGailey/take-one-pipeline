   "gate": "approve.schedule: dispatch.py refuses a publish/schedule run without an answered decisions/schedule-{k} (a yes, under consent.maxAgeH old, for the same batch hash); with consent.live false every such run stays with the owner"
  }
 },
 "route": {
  "_doc": "request context -> profile. action first, then stage, then kind. Anything in never is not agent work and is not started.",
  "stage": {
   "research": "research",
   "plan": "plan",
   "script": "design",
   "design": "design",
   "storyboard": "design",
   "package": "package",
   "capture": "capture",
   "edit": "edit",
   "qa": "qa",
   "QA": "qa",
   "measure": "rules",
   "rules": "rules",
   "publish": "publish"
  },
  "kind": {
   "cut": "edit",
   "episode": "message",
   "piece": "message",
   "general": "message"
  },
  "never": [
   "q",
   "bridge",
   "ask",
   "decide"
  ],
  "action": {
   "_doc": "checked before stage: demo tickets belong to the capture lane whatever stage raised them",
   "demo-test": "capture",
   "demo-notes": "capture",
   "demo": "capture",
   "waive": "qa"
  }
 },
 "pageOwned": {
  "^projects/{k}/stages/script$": [
   "frozen"
  ],
  "^projects/{k}/stages/plan$": [
   "pitchId",
   "greenlit",
   "evidence",
   "warnings",
   "slate",
   "brief"
  ],
  "^projects/{k}/deliverables/l\\d\\d$": [
   "title",
   "order",
   "retired",
   "notNeeded"
  ],
  "^posts/[^/]+$": [
   "plan",
   "projectKey",
   "deliverableId",
   "channel",
   "variant"
  ],
  "^decisions/[^/]+$": [
   "answer",
   "hold",
   "note",
   "undone",
   "legacyRequestId"
  ],
  "^topics/[^/]+$": [
   "suggestion",
   "rejected"
  ],
  "^projects/{k}/qa/[^/]+$": [
   "waived"
  ]
 },
 "followups": {
  "_doc": "every followup an agent lists must carry context.projectKey (collect fills it from the bundle's projectKey; a followup with none is dropped)"
 },
 "consent": {
  "_doc": "Scheduling posts is the one agent action that needs the owner's recorded yes first: decisions/schedule-{k}, answered yes within maxAgeH for the same batch hash. live=false: the guard refuses every publish/schedule run (the default here; the owner flips it).",
  "live": false,
  "maxAgeH": 24
 }
}
